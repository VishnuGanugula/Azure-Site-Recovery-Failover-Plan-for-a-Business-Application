#!/bin/bash
# Azure CLI Commands - Deploy SpendWise DR Infrastructure & Recovery Vault (India South Central)

# 1. Create DR Resource Group
az group create --name RG-ASR-24CC3046-DR --location indiasouthcentral

# 2. Create Cache Storage Account in Primary Region
CACHE_NAME="asrcache$RANDOM"
az storage account create --name $CACHE_NAME --resource-group RG-ASR-24CC3046 \
  --location centralindia --sku Standard_LRS --kind StorageV2

# 3. Create Test Failover VNet
az network vnet create --resource-group RG-ASR-24CC3046-DR \
  --name VNET-ASR-TEST --address-prefix 10.30.0.0/16 \
  --subnet-name SUBNET-TEST --subnet-prefix 10.30.1.0/24 \
  --location indiasouthcentral

# 4. Create Recovery Services Vault
az backup vault create --resource-group RG-ASR-24CC3046-DR \
  --name RSV-ASR-24CC3046 --location indiasouthcentral
